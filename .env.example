# Copy to .env for local development:  cp .env.example .env
# .env is gitignored. Never commit real values.

# Where this app is served. Leave unset in a deployment to use the deployed
# URL baked into settings.py; set it here so local runs come back to localhost
# after login.
APP_URL=http://127.0.0.1:8050/

# Warehouse / OAuth provider.
SITE_URL=https://apps.csipacific.ca

# The OAuth secret. The client id is a literal in settings.py and needs no
# variable -- do NOT add CLIENT_ID to a hosting panel, since a blank or
# mistyped value there overrides the working default and the provider answers
# with "Invalid client_id parameter value".
CLIENT_SECRET=

# Keeps Flask sessions valid across restarts and across multiple workers.
# Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET_KEY=

# Warehouse datasource UUIDs. Set only to point at different datasources.
# VO2_STEP_SOURCE_UUID=
# ERG_TEST_SOURCE_UUID=
